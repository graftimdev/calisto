<Window x:Class="Calisto.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calisto settings" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="White"
        FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource InkPrimary}">
    <StackPanel Margin="28,24">
        <TextBlock Text="Claude API key (optional)" FontWeight="SemiBold"/>
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource InkSecondary}" Margin="0,2,0,6"
                   Text="Calisto already works without a key, using its dictionary, Wiktionary and Wikipedia ranked by the surrounding text. With a key, the sentence is also sent to Claude for a more precise answer. The key is stored in your user profile folder."/>
        <PasswordBox x:Name="ApiKeyBox" Padding="6" Margin="0,0,0,16"/>

        <TextBlock Text="Update check URL" FontWeight="SemiBold"/>
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource InkSecondary}" Margin="0,2,0,6"
                   Text="GitHub latest-release API address used by Check for updates."/>
        <TextBox x:Name="UpdateUrlBox" Padding="6" Margin="0,0,0,20"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="Save" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>

<UserControl x:Class="Calisto.PlanetIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="88" Height="88">
    <!-- Same artwork as calisto.ico: dark disc, lit crescent on the upper right, three craters. Scales with the control. -->
    <Viewbox Stretch="Uniform">
        <Grid Width="88" Height="88">
            <Grid.Clip>
                <EllipseGeometry Center="44,44" RadiusX="44" RadiusY="44"/>
            </Grid.Clip>
            <Ellipse Width="88" Height="88" Fill="{StaticResource PlanetDark}"/>
            <Ellipse Width="104" Height="104" Fill="{StaticResource PlanetLit}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,-20,0,0"/>
            <Ellipse Width="16" Height="16" Fill="{StaticResource PlanetCrater}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="57,20,0,0"/>
            <Ellipse Width="10" Height="10" Fill="{StaticResource PlanetCrater}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="74,51,0,0"/>
            <Ellipse Width="8" Height="8" Fill="{StaticResource PlanetCrater}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="47,62,0,0"/>
        </Grid>
    </Viewbox>
</UserControl>

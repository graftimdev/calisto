<Window x:Class="Calisto.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Calisto"
        Title="Calisto menu" Width="300" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="True" ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="13" KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="FieldBox" TargetType="Control">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAFFFFFF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="12,8,12,3"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#88FFFFFF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="12,2,12,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF6B6B"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="12,4,12,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="Track" Width="36" Height="18" CornerRadius="9" Background="#44FFFFFF"/>
                            <Ellipse x:Name="Knob" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentGreen}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Panel" Background="#1B1F23" CornerRadius="14" Padding="10" BorderBrush="#33FFFFFF" BorderThickness="1">
        <StackPanel>
            <!-- Header: drag handle -->
            <Grid x:Name="Header" Cursor="SizeAll" Background="Transparent" Margin="2,0,0,8" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BackBtn" Content="&#x2039;" Visibility="Collapsed" Style="{StaticResource MenuRow}" Padding="6,0,8,2" FontSize="18" Foreground="#CCFFFFFF" Click="Back_Click" ToolTip="Back"/>
                    <local:PlanetIcon Width="20" Height="20" Margin="0,0,8,0"/>
                    <TextBlock x:Name="Title" Text="Calisto" Foreground="White" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="&#x2715;" HorizontalAlignment="Right" Style="{StaticResource MenuRow}" Padding="8,2" FontSize="11"
                        Foreground="#AAFFFFFF" Click="Close_Click" ToolTip="Hide menu"/>
            </Grid>

            <!-- ============ Main page ============ -->
            <StackPanel x:Name="MainPage">
                <TextBlock Style="{StaticResource Hint}" Margin="12,0,12,8" x:Name="HotkeyHint"/>
                <Button Style="{StaticResource MenuRow}" Click="AddApi_Click" AutomationProperties.Name="Add API key">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Add API key" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ApiState" Text="" Foreground="#88FFFFFF" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Content="Settings" Style="{StaticResource MenuRow}" Click="Settings_Click"/>
                <Button Content="Check for updates" Style="{StaticResource MenuRow}" Click="Update_Click"/>
                <Button Content="Close Calisto" Style="{StaticResource MenuRow}" Click="Exit_Click"/>
            </StackPanel>

            <!-- ============ Settings page ============ -->
            <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
                <Grid Margin="12,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Opacity" Foreground="#AAFFFFFF" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Slider x:Name="OpacitySlider" Grid.Column="1" Style="{StaticResource VolumeSlider}" Minimum="0.25" Maximum="1" Value="0.85"
                            IsMoveToPointEnabled="True" ValueChanged="OpacitySlider_ValueChanged" VerticalAlignment="Center"/>
                    <TextBlock x:Name="OpacityLabel" Grid.Column="2" Foreground="#AAFFFFFF" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="32" TextAlignment="Right"/>
                </Grid>

                <Grid Margin="12,14,12,0">
                    <StackPanel>
                        <TextBlock Text="Passive scan" Foreground="White"/>
                        <TextBlock Text="Quietly finds abbreviations in the active window and marks them with a def tag." Style="{StaticResource Hint}" Margin="0,2,40,0"/>
                    </StackPanel>
                    <CheckBox x:Name="PassiveToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0" Click="PassiveToggle_Click"/>
                </Grid>

                <TextBlock Text="Definitions language" Style="{StaticResource Label}" Margin="12,14,12,3"/>
                <ComboBox x:Name="LanguageBox" Margin="12,0,12,0" SelectionChanged="LanguageBox_SelectionChanged" DisplayMemberPath="Name" SelectedValuePath="Code"/>

                <TextBlock Text="Word lookup hotkey" Style="{StaticResource Label}" Margin="12,14,12,3"/>
                <TextBlock Text="Select any word in any app and press the keys. Click the box, then press the combination you want." Style="{StaticResource Hint}" Margin="12,0,12,4"/>
                <TextBox x:Name="HotkeyBox" Style="{StaticResource FieldBox}" Margin="12,0,12,0" IsReadOnly="True" Cursor="Hand"
                         PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus" CaretBrush="Transparent"/>
                <TextBlock x:Name="HotkeyError" Style="{StaticResource ErrorText}" Visibility="Collapsed"/>

                <TextBlock Text="Offline dictionary" Style="{StaticResource Label}" Margin="12,14,12,3"/>
                <Grid Margin="12,0,12,0">
                    <TextBlock x:Name="PackState" Foreground="#CCFFFFFF" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,100,0"/>
                    <Button x:Name="PackBtn" Content="Download" Style="{StaticResource MenuRow}" HorizontalAlignment="Right" Foreground="{StaticResource AccentGreen}" FontWeight="SemiBold" Click="Pack_Click" Padding="10,5"/>
                </Grid>
                <ProgressBar x:Name="PackProgress" Height="4" Margin="12,6,12,0" Visibility="Collapsed" Foreground="{StaticResource AccentGreen}" Background="#33FFFFFF" BorderThickness="0"/>

                <Border BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0" Margin="4,14,4,0" Padding="0,6,0,0">
                    <Button Content="Contribute a definition" Style="{StaticResource MenuRow}" Click="Contribute_Click"/>
                </Border>
            </StackPanel>

            <!-- ============ API key page ============ -->
            <StackPanel x:Name="ApiPage" Visibility="Collapsed">
                <TextBlock Style="{StaticResource Hint}" Margin="12,0,12,6"
                           Text="Calisto already works without a key. With a Claude API key, the sentence around the word is also sent to Claude for a more precise answer. The key stays on this PC."/>
                <PasswordBox x:Name="ApiKeyBox" Style="{StaticResource FieldBox}" Margin="12,4,12,0"/>
                <TextBlock x:Name="ApiError" Style="{StaticResource ErrorText}" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" Margin="2,8,0,0">
                    <Button Content="Save key" Style="{StaticResource MenuRow}" Foreground="{StaticResource AccentGreen}" FontWeight="SemiBold" Click="SaveApi_Click"/>
                    <Button x:Name="RemoveApiBtn" Content="Remove key" Style="{StaticResource MenuRow}" Foreground="#CCFFFFFF" Click="RemoveApi_Click"/>
                </StackPanel>
            </StackPanel>

            <!-- ============ Contribute page ============ -->
            <StackPanel x:Name="ContributePage" Visibility="Collapsed">
                <TextBlock Style="{StaticResource Hint}" Margin="12,0,12,4"
                           Text="Add a word or abbreviation to the shared dictionary that every Calisto user gets. It is submitted through GitHub, so a GitHub account is needed on the page that opens."/>
                <TextBlock Text="Word or abbreviation" Style="{StaticResource Label}"/>
                <TextBox x:Name="ContribWord" Style="{StaticResource FieldBox}" Margin="12,0,12,0" MaxLength="40"/>
                <TextBlock Text="Definition" Style="{StaticResource Label}"/>
                <TextBox x:Name="ContribDef" Style="{StaticResource FieldBox}" Margin="12,0,12,0" MaxLength="300" TextWrapping="Wrap" AcceptsReturn="False" MinHeight="60" VerticalContentAlignment="Top"/>
                <TextBlock x:Name="ContribError" Style="{StaticResource ErrorText}" Visibility="Collapsed"/>
                <TextBlock x:Name="ContribOk" Style="{StaticResource Hint}" Foreground="{StaticResource AccentGreen}" Visibility="Collapsed" Margin="12,4,12,0"/>
                <Button Content="Submit on GitHub" Style="{StaticResource MenuRow}" Foreground="{StaticResource AccentGreen}" FontWeight="SemiBold" Margin="2,8,0,0" Click="SubmitContribution_Click"/>
            </StackPanel>

            <!-- Inline message (errors, hints) -->
            <TextBlock x:Name="Message" Visibility="Collapsed" Foreground="#FFD27B" Margin="12,8,12,2" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>
